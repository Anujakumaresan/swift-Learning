//Find the largest element

let numbers = [10, 25, 5, 40, 15]

var maxNum = numbers[0]

for num in numbers {
    if num > maxNum {
        maxNum = num
    }
}

print(maxNum)


//Finding Array Length

let numbers = [10, 20, 30, 40, 50]

print(numbers.count)


//sum of array elements

let numbers = [10, 20, 30, 40]

var sum = 0

for num in numbers {
    sum += num
}

print(sum)

//Count even numbers

let numbers = [1, 2, 3, 4, 5, 6]

var count = 0

for num in numbers {
    if num % 2 == 0 {
        count += 1
    }
}

print(count)